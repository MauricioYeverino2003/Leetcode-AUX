# Copy to .env and fill in. .env is gitignored.

# Which vendor answers /chat: anthropic or openai. The tutor is the same either
# way — only the API plumbing differs. One line to switch.
LLM_PROVIDER=anthropic

# --- Anthropic -------------------------------------------------------------
# Buy the minimum credit block and leave auto-reload off: the balance is then
# a hard spending cap.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI ----------------------------------------------------------------
# Free daily tokens (if eligible) come from the data-sharing opt-in on the
# OpenAI platform, not from anything configured here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Supabase --------------------------------------------------------------
# The project whose users this backend serves. Access tokens are verified
# against <url>/auth/v1/.well-known/jwks.json.
#   local stack:    http://127.0.0.1:54321
#   hosted project: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Only for a Supabase instance that signs tokens with a shared secret (HS256).
# Current local and hosted projects sign asymmetrically; leave this empty.
# SUPABASE_JWT_SECRET=
