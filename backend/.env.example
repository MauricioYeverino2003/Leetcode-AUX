# Copy to .env and fill in. .env is gitignored.

# Which vendor answers /chat: anthropic or openai. The tutor is the same either
# way — only the API plumbing differs. One line to switch.
LLM_PROVIDER=anthropic

# --- Anthropic -------------------------------------------------------------
# Buy the minimum credit block and leave auto-reload off: the balance is then
# a hard spending cap.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI ----------------------------------------------------------------
# Free daily tokens (if eligible) come from the data-sharing opt-in on the
# OpenAI platform, not from anything configured here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# The model that writes solution summaries, if not the chat model (same
# vendor). Importing a LeetCode history makes one summary per solved problem,
# so a small model here matters: gpt-5-mini is roughly a fifth of the cost.
# Unset = the chat model.
SUMMARY_MODEL=gpt-5-mini

# Recall by meaning embeds each saved solution and each chat's problem with
# this model. OpenAI only (Anthropic has no embeddings API), so recall needs
# OPENAI_API_KEY even when LLM_PROVIDER=anthropic; without it, recall falls
# back to topic tags. The vector size is built into the solutions table
# (3,072 = text-embedding-3-large), so a model of another size needs a
# migration too.
EMBEDDING_MODEL=text-embedding-3-large

# --- Tuning and benchmarks --------------------------------------------------
# How hard the model thinks: low | medium | high | xhigh | max. Both vendors
# accept the same five. Unset = provider default. Reasoning tokens are most of
# the latency and cost, so try "low" first for short hints.
LLM_EFFORT=

# Every model call is appended as one JSON line here (relative to backend/),
# including the prompt and the user's code. Gitignored. Empty = disabled.
#   uv run python -m app.benchmarks report   -> docs/benchmarks.md
#   uv run python -m app.benchmarks run      -> replay benchmarks/cases.json
BENCHMARKS_PATH=benchmarks/runs.jsonl

# --- Supabase --------------------------------------------------------------
# The project whose users this backend serves. Access tokens are verified
# against <url>/auth/v1/.well-known/jwks.json.
#   local stack:    http://127.0.0.1:54321
#   hosted project: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# The project's public anon key — the same value the extension uses as
# VITE_SUPABASE_ANON_KEY (`npm run db:status` at the repo root prints it).
# Needed to save accepted solutions: the backend calls Supabase's REST API with
# this key plus the user's own token, so row-level security applies. Not a
# secret, and not the service-role key — never put that one here.
SUPABASE_ANON_KEY=

# Only for a Supabase instance that signs tokens with a shared secret (HS256).
# Current local and hosted projects sign asymmetrically; leave this empty.
# SUPABASE_JWT_SECRET=
